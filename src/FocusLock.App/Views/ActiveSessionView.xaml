<UserControl x:Class="FocusLock.App.Views.ActiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLock.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,32" MaxWidth="600">
      <TextBlock Text="{Binding PhaseText}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />

      <Grid Width="280" Height="280" Margin="0,20,0,20">
        <controls:RingProgress Value="{Binding Progress}"
                               Thickness="10"
                               TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                               ProgressBrush="{StaticResource AppAccentBrush}" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding CountdownText}"
                     Style="{StaticResource CountdownText}"
                     HorizontalAlignment="Center"
                     AutomationProperties.Name="{Binding CountdownAccessibleText}" />
          <TextBlock Text="{Binding CycleText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding PhaseHint}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextAlignment="Center" />
      <TextBlock Text="{Binding BlockedText}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
      <TextBlock Text="{Binding EndsAtText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,4,0,0" />

      <Button Content="End early"
              Command="{Binding EndEarlyCommand}"
              HorizontalAlignment="Center"
              Margin="0,28,0,0"
              Visibility="{Binding IsGateOpen, Converter={StaticResource InvertedBoolToVisibility}}" />

      <!-- Strict mode: wait a minute or type the sentence -->
      <Border Style="{StaticResource Card}"
              Margin="0,28,0,0"
              MaxWidth="460"
              Visibility="{Binding IsGateOpen, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="End the session early">
        <StackPanel>
          <TextBlock Text="Sure you want to stop?" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding GateWaitText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding GateSentence}" Style="{StaticResource BodyText}" FontStyle="Italic" Margin="0,12,0,0" />
          <TextBox Text="{Binding GateTypedText, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,8,0,0"
                   AutomationProperties.Name="Type the sentence to end the session early" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="End session" Command="{Binding ConfirmEndEarlyCommand}" Margin="0,0,8,0" />
            <Button Content="Keep focusing" Style="{StaticResource SubtleButton}" Command="{Binding KeepFocusingCommand}" IsCancel="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
