<Window x:Class="FocusLock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <StackPanel Grid.Column="0" Margin="8,20,8,16">
      <TextBlock Text="FocusLock" Style="{StaticResource BrandText}" Margin="14,0,0,18" />
      <ItemsControl ItemsSource="{Binding Pages}" IsTabStop="False" KeyboardNavigation.TabNavigation="Once">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource NavRadioButton}"
                         GroupName="Navigation"
                         Content="{Binding Label}"
                         Tag="{Binding Glyph}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Page -->
    <Border Grid.Column="1"
            Margin="0,8,8,8"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </Border>
  </Grid>
</Window>
