<Window x:Class="FocusLock.App.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add an app to the blocklist"
        Width="560"
        Height="600"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Pick an app to close during focus sessions. Apps that are open right now are at the top."
               Style="{StaticResource SecondaryText}"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <TextBox x:Name="Search"
             Grid.Row="1"
             Margin="0,0,0,10"
             TextChanged="OnSearchChanged"
             PreviewKeyDown="OnSearchKeyDown"
             AutomationProperties.Name="Search for an app" />

    <ListBox x:Name="Apps"
             Grid.Row="2"
             MouseDoubleClick="OnListDoubleClick"
             AutomationProperties.Name="Apps">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4" AutomationProperties.Name="{Binding Name}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="NoMatches"
               Grid.Row="2"
               Text="No apps match. Try another name, or browse for it below."
               Style="{StaticResource SecondaryText}"
               TextWrapping="Wrap"
               Margin="12"
               Visibility="Collapsed" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock Text="Not in the list?" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Content="Browse for a program…" Click="OnBrowseFile" Margin="0,0,8,0" />
      <Button Content="Browse for a folder…" Click="OnBrowseFolder" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAdd" MinWidth="88" Margin="0,0,8,0" />
      <Button Content="Cancel" IsCancel="True" MinWidth="88" />
    </StackPanel>
  </Grid>
</Window>
