<UserControl x:Class="FocusLock.App.Views.BlocklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusLock.App.ViewModels">
  <UserControl.Resources>
    <!-- One detected game -->
    <DataTemplate x:Key="GameRow" DataType="{x:Type vm:GameItemViewModel}">
      <Border Style="{StaticResource ListRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Remove"
                  Style="{StaticResource SubtleButton}"
                  Command="{Binding RemoveCommand}"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{Binding RemoveAccessibleName}" />
          <ToggleButton Grid.Column="2"
                        Style="{StaticResource ToggleSwitch}"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ToggleAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One source section -->
    <DataTemplate x:Key="GroupCard" DataType="{x:Type vm:GameGroupViewModel}">
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}">
              <Button Content="Add app…" Command="{Binding AddAppCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Add an app to the blocklist" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding EmptyText}"
                     Style="{StaticResource SecondaryText}"
                     Margin="16,0,16,16"
                     Visibility="{Binding HasItems, Converter={StaticResource InvertedBoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GameRow}" IsTabStop="False" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One built-in site -->
    <DataTemplate x:Key="SitePresetRow" DataType="{x:Type vm:SitePresetItemViewModel}">
      <Border Style="{StaticResource ListRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1"
                        Style="{StaticResource ToggleSwitch}"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ToggleAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One website added by the person -->
    <DataTemplate x:Key="CustomSiteRow" DataType="{x:Type vm:CustomSiteItemViewModel}">
      <Border Style="{StaticResource ListRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Domain}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Style="{StaticResource SubtleButton}"
                  Command="{Binding RemoveCommand}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding RemoveAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One allowed program -->
    <DataTemplate x:Key="AllowRow" DataType="{x:Type vm:AllowItemViewModel}">
      <Border Style="{StaticResource ListRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Remove"
                  Style="{StaticResource SubtleButton}"
                  Command="{Binding RemoveCommand}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding RemoveAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32" MaxWidth="760" HorizontalAlignment="Left">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Blocklist" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Look again"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Look for installed games again" />
      </Grid>
      <TextBlock Text="Games on this list are closed while a focus session runs. Switch one off to leave it alone."
                 Style="{StaticResource SecondaryText}"
                 Margin="0,0,0,6" />
      <TextBlock Text="Changes here apply to your next session."
                 Style="{StaticResource CaptionText}"
                 Margin="0,0,0,16"
                 Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="Looking for your games…"
                 Style="{StaticResource CaptionText}"
                 Margin="0,0,0,12"
                 Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupCard}" IsTabStop="False" Margin="0,8,0,0" />

      <!-- Websites -->
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" IsEnabled="{Binding CanEditSites}">
        <StackPanel>
          <StackPanel Margin="16,14,16,12">
            <TextBlock Text="Websites" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="These sites won't open in any browser while a focus session runs." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding SitePresets}" ItemTemplate="{StaticResource SitePresetRow}" IsTabStop="False" />
          <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewSite, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="Add a website">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddSiteCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Add" Command="{Binding AddSiteCommand}" AutomationProperties.Name="Add website" />
          </Grid>
          <TextBlock Text="{Binding SiteMessage}"
                     Style="{StaticResource CaptionText}"
                     Margin="16,6,16,0"
                     Visibility="{Binding HasSiteMessage, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="No websites added yet. Type an address like example.com."
                     Style="{StaticResource SecondaryText}"
                     Margin="16,12,16,16"
                     Visibility="{Binding HasCustomSites, Converter={StaticResource InvertedBoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding CustomSites}" ItemTemplate="{StaticResource CustomSiteRow}" IsTabStop="False" Margin="0,8,0,8" />
        </StackPanel>
      </Border>

      <!-- Allowlist -->
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
        <StackPanel>
          <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Always allowed" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="These are never closed, even if they match something above." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="Add app…" Command="{Binding AddAllowedAppCommand}" Margin="0,0,8,0" AutomationProperties.Name="Add an allowed app" />
              <Button Content="Add folder…" Command="{Binding AddAllowedFolderCommand}" AutomationProperties.Name="Add an allowed folder" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Nothing here yet."
                     Style="{StaticResource SecondaryText}"
                     Margin="16,0,16,16"
                     Visibility="{Binding HasAllowed, Converter={StaticResource InvertedBoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Allowed}" ItemTemplate="{StaticResource AllowRow}" IsTabStop="False" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
