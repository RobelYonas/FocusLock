<UserControl x:Class="FocusLock.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="SettingRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" Margin="0,0,0,20" />

      <!-- Pomodoro -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Pomodoro" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" />

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Use focus blocks with short breaks" Style="{StaticResource BodyText}" />
              <TextBlock Text="Focus, short break, focus… Games are allowed during breaks." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding PomodoroEnabled}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Use focus blocks with short breaks" />
          </Grid>

          <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding PomodoroEnabled}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Break length" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Column="1"
                    Width="220"
                    Minimum="1"
                    Maximum="30"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding BreakMinutes}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Break length in minutes" />
            <TextBlock Grid.Column="2" Text="{Binding BreakMinutesText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>

          <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding PomodoroEnabled}" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Focus blocks per session" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Column="1"
                    Width="220"
                    Minimum="2"
                    Maximum="12"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding Cycles}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Focus blocks per session" />
            <TextBlock Grid.Column="2" Text="{Binding CyclesText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Blocking -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Blocking" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" />

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Close games that are already open when a session starts" Style="{StaticResource BodyText}" />
              <TextBlock Text="Otherwise only games started during the session are closed." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding CloseAlreadyRunning}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Close games that are already open when a session starts" />
          </Grid>

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Also close game launchers" Style="{StaticResource BodyText}" />
              <TextBlock Text="Steam, Epic Games Launcher, GOG Galaxy, EA app, Ubisoft Connect, Battle.net and Riot Client." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding BlockLaunchers}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Also close game launchers" />
          </Grid>

          <Grid Style="{StaticResource SettingRow}" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Strict mode" Style="{StaticResource BodyText}" />
              <TextBlock Text="Ending a session early takes a 60-second wait or typing a sentence." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding StrictMode}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Strict mode" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- General -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="General" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" />

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Start FocusLock when I sign in" Style="{StaticResource BodyText}" />
              <TextBlock Text="It starts minimized, in the corner of the taskbar." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding LaunchAtStartup}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Start FocusLock when I sign in" />
          </Grid>

          <Grid Style="{StaticResource SettingRow}" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="Show a notification when a game is closed" Style="{StaticResource BodyText}" />
              <TextBlock Text="A small note in the corner of the screen, also for breaks." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding ShowNotifications}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Show a notification when a game is closed" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
