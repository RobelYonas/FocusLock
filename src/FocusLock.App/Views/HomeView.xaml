<UserControl x:Class="FocusLock.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Summary of the session that just ended -->
      <Border Grid.Row="0"
              Style="{StaticResource Card}"
              MaxWidth="520"
              HorizontalAlignment="Center"
              Margin="0,0,0,24"
              Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="Session summary">
        <StackPanel>
          <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding SummaryBody}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          <Button Content="Done" Command="{Binding DismissSummaryCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
        <TextBlock Text="{Binding TimerText}"
                   Style="{StaticResource TimerText}"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="{Binding TimerAccessibleText}" />

        <TextBlock Text="{Binding PlanText}"
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasPlanText, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Options}"
                      HorizontalAlignment="Center"
                      Margin="0,16,0,0"
                      IsTabStop="False"
                      KeyboardNavigation.TabNavigation="Once">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource PillRadioButton}"
                           GroupName="SessionLength"
                           Content="{Binding Label}"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding AccessibleName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
          <TextBlock x:Name="MinutesLabel" Text="Minutes" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Width="96"
                   Text="{Binding CustomMinutesText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.LabeledBy="{Binding ElementName=MinutesLabel}" />
        </StackPanel>

        <TextBlock Text="{Binding ValidationText}"
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" />

        <Button Content="Start focus"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding StartCommand}"
                HorizontalAlignment="Center"
                Margin="0,28,0,0"
                IsDefault="True" />

        <TextBlock Text="{Binding ErrorText}"
                   Style="{StaticResource CaptionText}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" />

        <TextBlock Text="{Binding StatusText}"
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,20,0,0" />

        <TextBlock Text="{Binding TodayText}"
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
